{
    "name": "sick-doggy/messenger-monitoring-bundle",
    "description": "Symfony Messenger message lifecycle monitoring bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.4",
        "symfony/messenger": "^6.4",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/http-client": "^6.4",
        "symfony/uid": "^6.4",
        "symfony/yaml": "^6.4",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "symfony/serializer": "^6.4"
    },
    "scripts": {
        "phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "phpstan": "Analiza kodu: phpstan analyse (poziom 8, katalog src)"
    },
    "autoload": {
        "psr-4": {
            "SickDoggy\\MessengerMonitoring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SickDoggy\\MessengerMonitoring\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "suggest": {
        "symfony/serializer": "Wymagane do atrybutu #[Payload] (serializacja message do store'a)"
    }
}