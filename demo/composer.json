{
    "name": "sick-doggy/messenger-monitoring-bundle-demo",
    "description": "Demo aplikacji korzystającej z sick-doggy/messenger-monitoring-bundle",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "sick-doggy/messenger-monitoring-bundle": "@dev",
        "symfony/framework-bundle": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/runtime": "^6.4",
        "symfony/yaml": "^6.4",
        "symfony/doctrine-messenger": "^6.4",
        "doctrine/doctrine-bundle": "^2.12",
        "symfony/serializer": "^6.4",
        "symfony/property-access": "^6.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
